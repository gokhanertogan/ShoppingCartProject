{
  "ConnectionStrings": {
    "ShoppingCartDb": "Host=localhost;Port=5432;Database=shoppingcart;Username=shoppingcart;Password=Your_password123",
    "RabbitMq": "amqp://shoppingcart:Your_password123@localhost:5672/"
  },
  "RabbitMq": {
    "ExchangeName": "shopping-cart.events",
    "QueuePrefix": "shopping-cart"
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
